# Vorlage für lokale Umgebungsvariablen.
#
# Kopieren nach .env und ausfüllen. .env ist in .gitignore und darf NIEMALS
# committet werden – die Werte hier sind Platzhalter, keine echten Schlüssel.
#
# Im Betrieb kommen diese Werte NICHT aus einer .env, sondern aus Firebase
# Secrets (siehe RUNME.sh). Diese Datei ist für lokale Emulator-Läufe und
# damit klar dokumentiert ist, welche Geheimnisse das System überhaupt kennt.

# ── Stripe ────────────────────────────────────────────────────────────────
# Aus dem Stripe-Dashboard → Developers → API keys.
# ERST mit Testschlüsseln (sk_test_…) arbeiten, nie direkt live.
STRIPE_SECRET_KEY=sk_test_HIER_EINSETZEN

# Aus dem Dashboard → Developers → Webhooks → Endpoint → Signing secret.
# Ohne diesen Wert ist der Webhook wertlos: Jeder könnte sich ein Abo eintragen.
STRIPE_WEBHOOK_SECRET=whsec_HIER_EINSETZEN

# Preis-Kennungen der angelegten Produkte (keine Geheimnisse, aber nötig).
STRIPE_PRICE_MONTHLY=price_HIER_EINSETZEN
STRIPE_PRICE_ANNUAL=price_HIER_EINSETZEN

# ── Apple ─────────────────────────────────────────────────────────────────
# Aus App Store Connect → Benutzer und Zugriff → Integrationen → In-App-Käufe.
APPLE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_KEY_ID=ABCD123456

# Der private Schlüssel (.p8) als EINZEILIGER Text, Zeilenumbrüche als \n.
# Dieser Schlüssel ist nur EINMAL herunterladbar – geht er verloren, muss ein
# neuer erzeugt werden.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nHIER_EINSETZEN\n-----END PRIVATE KEY-----"

# Muss exakt der Bundle-ID der iOS-App entsprechen. Verhindert, dass
# Benachrichtigungen für fremde Apps bei uns Wirkung entfalten.
APPLE_BUNDLE_ID=com.pokermentor.app
