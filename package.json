{
  "name": "pokermentor",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "description": "PokerMentor – die Poker-Lern-App: Strategien, Training und Tools für Online- und Live-Poker",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "test:rules": "npx --yes firebase-tools@15.28.1 emulators:exec --only firestore --project pokermentor-rules-test 'vitest run --config vitest.rules.config.ts'",
    "daten": "node scripts/pokermath-app-daten.mjs",
    "streuung": "node scripts/design-streuung.mjs",
    "wege": "node scripts/wege-pruefen.mjs",
    "tisch": "node scripts/tisch-messen.mjs",
    "durchgang": "node scripts/durchgang-pruefen.mjs",
    "pruefen": "node scripts/design-pruefen.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^12.18.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
